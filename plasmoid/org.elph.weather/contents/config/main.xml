<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>
    <group name="General">
        <!-- Место определяется по IP-адресу; название и координаты ниже действуют, когда определение отключено -->
        <entry name="autoLocation" type="Bool">
            <default>true</default>
        </entry>
        <!-- Значения по умолчанию – условное место (Гринвич), чтобы виджет работал и без определения по IP -->
        <entry name="cityName" type="String">
            <default>Greenwich</default>
        </entry>
        <entry name="latitude" type="String">
            <default>51.48</default>
        </entry>
        <entry name="longitude" type="String">
            <default>0.00</default>
        </entry>
        <entry name="updateInterval" type="Int">
            <default>15</default>
        </entry>
        <entry name="tempUnit" type="String">
            <default>c</default>
        </entry>
        <entry name="windUnit" type="String">
            <default>ms</default>
        </entry>
        <entry name="pressureUnit" type="String">
            <default>mmhg</default>
        </entry>
        <entry name="precipUnit" type="String">
            <default>mm</default>
        </entry>
        <entry name="showHourly" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showDaily" type="Bool">
            <default>true</default>
        </entry>
        <!-- Тенденции: срок сравнения в часах и пороги. Пороги температуры, ветра, порывов и давления хранятся в десятых долях (5 = 0,5), влажности – в процентах -->
        <entry name="trendHours" type="Int">
            <default>1</default>
        </entry>
        <entry name="trendTemp" type="Int">
            <default>5</default>
        </entry>
        <entry name="trendHumidity" type="Int">
            <default>3</default>
        </entry>
        <entry name="trendWind" type="Int">
            <default>5</default>
        </entry>
        <entry name="trendGusts" type="Int">
            <default>10</default>
        </entry>
        <entry name="trendPressure" type="Int">
            <default>5</default>
        </entry>
    </group>
</kcfg>
